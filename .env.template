"""
Environment Configuration Template
Copy this to .env and fill in your values
For Indian Market (NSE) - Times shown in Germany timezone
"""

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Market Settings (24-hour format, Germany timezone)
# Indian market: Opens 9:15 AM IST, Closes 3:30 PM IST
# Germany times (auto-adjusts for DST):
#   6:00 AM = ~30 mins after NSE open
#   11:00 AM = ~30 mins before NSE close
MARKET_OPEN_TIME=06:00
MARKET_CLOSE_TIME=11:00

# Setup Grades to Report (A, B, C, D, all)
SETUP_GRADES=A,B

# Notification Settings
NOTIFY_ON_TREND_PASS=True
NOTIFY_ON_VCP_ONLY=False
NOTIFY_ON_VALID_SETUPS_ONLY=True
