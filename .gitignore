# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
env/
venv/
ENV/

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Sensitive credentials — copy telegram_config.example.py and fill in your values
telegram_config.py

# Windows Task Scheduler helper scripts (auto-generated by setup_scheduler.py)
*.bat
*.vbs

# Ignore output folder contents (generated files only)
output/*
# But keep these specific modules
!output/__init__.py
!output/charts.py
!output/console.py
!output/exporter.py
!output/.gitkeep
